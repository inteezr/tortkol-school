{
  "name": "tortkol-school-platform",
  "version": "1.0.0",
  "private": true,
  "description": "To'rtko'l tuman ixtisoslashtirilgan maktabi rasmiy veb-platformasi",
  "scripts": {
    "dev:web": "pnpm --filter @school/web dev",
    "dev:api": "pnpm --filter @school/api start:dev",
    "build:web": "pnpm --filter @school/web build",
    "build:api": "pnpm --filter @school/api build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
