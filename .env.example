# ========================================================
# To'rtko'l Ixtisoslashtirilgan Maktabi - Muhit o'zgaruvchilari
# Ushbu fayldan nusxa olib .env.local nomi bilan saqlang
# ========================================================

# 1. Supabase loyiha sozlamalari (supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. To'g'ridan-to'g'ri Database URL (supabase.com -> Project Settings -> Database)
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# 3. Ilova sozlamalari
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super-secret-jwt-key-turtkol-school-2026

# 4. Admin panel kirish ma'lumotlari
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kamida-12-belgili-parol

# 5. Avto-tarjima (ixtiyoriy, sifatni oshiradi): GEMINI_API_KEY yoki ANTHROPIC_API_KEY
GEMINI_API_KEY=

# 6. Rasmlar uchun Cloudflare R2 (bepul 10 GB). To'ldirilmasa rasmlar bazaga (uploads jadvali) yoziladi.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
